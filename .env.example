APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./claimcheck.db
OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org
OPENFOODFACTS_USER_AGENT=ClaimCheck/0.1 (contact: configure-before-production)
OPENFOODFACTS_TIMEOUT_SECONDS=10
ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_BYTES=10485760
BENCHMARK_PATH=data/benchmark/records.json
POSTGRES_DB=claimcheck
POSTGRES_USER=claimcheck
POSTGRES_PASSWORD=replace-with-local-password
